# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
# Supabase (free): https://supabase.com → New project → Settings → Database → URI
# Neon (free):     https://neon.tech → New project → Connection string
DATABASE_URL="postgresql://user:password@host:5432/silent_key?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-random-secret-here"

# Local dev:
NEXTAUTH_URL="http://localhost:3000"
# Production (Vercel sets this automatically, but add it anyway):
# NEXTAUTH_URL="https://your-app.vercel.app"
